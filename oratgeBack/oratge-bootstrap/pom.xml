<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.oratge</groupId>
		<artifactId>oratge-back</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<artifactId>oratge-bootstrap</artifactId>
	<packaging>jar</packaging>
	<name>oratge-bootstrap</name>
	<description>Módulo ejecutable (composition root): ensambla todos los módulos y arranca la aplicación Spring Boot.</description>

	<dependencies>
		<dependency>
			<groupId>com.oratge</groupId>
			<artifactId>oratge-domain</artifactId>
		</dependency>
		<dependency>
			<groupId>com.oratge</groupId>
			<artifactId>oratge-application</artifactId>
		</dependency>
		<dependency>
			<groupId>com.oratge</groupId>
			<artifactId>oratge-adapter-out-aemet</artifactId>
		</dependency>
		<dependency>
			<groupId>com.oratge</groupId>
			<artifactId>oratge-adapter-in-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
